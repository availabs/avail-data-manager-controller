#!/usr/bin/env node

/* eslint-disable @typescript-eslint/no-var-requires */

require("ts-node").register();
require("tsconfig-paths").register();

const { join } = require("path");

const yargs = require("yargs/yargs");
const { hideBin } = require("yargs/helpers");
const { table } = require("table");

const dama_db = require("data_manager/dama_db").default;
const dama_events = require("data_manager/events").default;
const dama_contexts = require("data_manager/contexts");
const logger = require("data_manager/logger").default;
const dama_host_id = require("constants/damaHostId").default;
const getEltWorkDir = require("var/getEtlWorkDir").default;

const worker_path = join(__dirname, "./worker.ts");
const worker_main = require(".").default;

const {
  pg_env, //
  etl_context_id = null,
  logging_level,
} = yargs(hideBin(process.argv))
  .strict()
  .options({
    pg_env: {
      alias: "p",
      describe: "The PostgresSQL Database",
      demandOption: true,
    },

    logging_level: {
      alias: "l",
      describe: "The logging level",
      demandOption: false,
      default: "debug",
      choices: ["error", "warn", "info", "debug", "silly"],
    },
  }).argv;

logger.level = logging_level;

async function main() {
  let eci = etl_context_id;

  if (eci === null) {
    eci = await dama_events.spawnEtlContext(null, null, pg_env);
  }

  const task_etl_context = {
    meta: { pgEnv: pg_env, etl_context_id: eci },
  };

  const events = await dama_contexts.runInDamaContext(
    task_etl_context,
    dama_events.getAllEtlContextEvents.bind(dama_events)
  );

  let initial_event = events.find((e) => e.type === ":INITIAL");

  if (!initial_event) {
    initial_event = await dama_contexts.runInDamaContext(
      task_etl_context,
      dama_events.dispatch.bind(dama_events, {
        type: ":INITIAL",
        payload: null,
        meta: {
          note: `TRANSCOM Events from latest in DB to current time.`,
          __dama_task_manager__: {
            dama_host_id,
            worker_path,
          },
        },
      })
    );
  }

  logger.info(`==> etl_context_id: ${eci}`);
  logger.info(`==> initial_event: ${JSON.stringify(initial_event, null, 4)}`);

  console.log(getEltWorkDir);
  const etl_work_dir = await dama_contexts.runInDamaContext(
    task_etl_context,
    getEltWorkDir
  );

  logger.info(etl_work_dir);

  let since_event_id = initial_event.event_id;

  const log_events_interval = setInterval(async () => {
    const context_tree_events = await dama_contexts.runInDamaContext(
      task_etl_context,
      dama_events.queryEvents.bind(dama_events, since_event_id)
    );

    if (context_tree_events.length) {
      since_event_id =
        context_tree_events[context_tree_events.length - 1].event_id;

      const rows = context_tree_events.map(
        ({
          parent_context_id,
          etl_context_id: event_etl_context_id,
          event_id,
          type,
        }) => [parent_context_id, event_etl_context_id, event_id, type]
      );

      const table_contents = [
        ["parent_etl_context_id", "etl_context_id", "event_id", "type"],
        ...rows,
      ];

      const d = table(table_contents, {
        header: { alignment: "center", content: "ETL Context Tree Events" },
      });

      logger.info(`\n${d}\n`);
    }
  }, 1000);

  await dama_contexts.runInDamaContext(task_etl_context, worker_main);

  console.log("DOWNLOAD->EXTRACT->TRANSFORM->LOAD->INTEGRATE PIPELINE DONE");

  clearInterval(log_events_interval);

  await dama_events.shutdown();
  await dama_db.shutdown();

  process.exit();
}

main();
